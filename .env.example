# Copia questo file in .env e inserisci i tuoi valori da Supabase
# (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...la-tua-anon-key

# Base path per GitHub Pages (default /utree/). Per dominio custom usa /
# VITE_BASE=/utree/

# --- Google Calendar (opzionale) ---
# Abilita il collegamento del calendario: ogni utente collega il PROPRIO account
# Google e le righe con scadenza vengono sincronizzate come eventi.
# Come ottenerlo:
#   1. Google Cloud Console -> crea/usa un progetto
#   2. "API e servizi" -> abilita "Google Calendar API"
#   3. "Credenziali" -> "Crea credenziali" -> "ID client OAuth" -> tipo "Applicazione web"
#   4. In "Origini JavaScript autorizzate" aggiungi gli URL dell'app
#      (es. http://localhost:5173 e https://TUO-UTENTE.github.io)
#   5. Copia l'ID client qui sotto (finisce con .apps.googleusercontent.com)
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Email di invito al team (opzionale) ---
# NON sono variabili di questo file: sono segreti della Edge Function su Supabase,
# perche' la chiave dell'API di posta non puo' finire nel bundle del browser.
#   supabase functions deploy invita-team
#   supabase secrets set MAILEROO_API_KEY=la-tua-sending-key
#   supabase secrets set UTREE_MITTENTE="uTree <invito@tuodominio.it>"
#   supabase secrets set UTREE_APP_URL=https://TUO-UTENTE.github.io/utree/
# Senza, gli inviti restano validi ma l'email non parte: la pagina Team lo dice
# e offre il link da mandare a mano.
#
# Le email di SISTEMA (conferma registrazione, reset password) sono un'altra cosa:
# le manda Supabase, e vanno configurate con l'SMTP di Maileroo dal suo pannello
# (Project Settings -> Authentication -> SMTP Settings). Dettagli nel README.
